{
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
       "business_intelligence": {
           "type": "object",
           "properties": {
               "market_analysis": {
                   "type": "object",
                   "properties": {
                       "tours_by_category": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "properties": {
                                   "category": {
                                       "type": "string",
                                       "enum": [
                                           "easy",
                                           "moderate",
                                           "challenging",
                                           "difficult",
                                           "expert"
                                       ]
                                   },
                                   "count": {
                                       "type": "integer",
                                       "minimum": 0
                                   },
                                   "avg_distance_km": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "avg_price_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "avg_duration_days": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "total_capacity": {
                                       "type": "integer",
                                       "minimum": 0
                                   },
                                   "total_participants": {
                                       "type": "integer",
                                       "minimum": 0
                                   },
                                   "market_share_percent": {
                                       "type": "number",
                                       "minimum": 0,
                                       "maximum": 100
                                   }
                               },
                               "required": [
                                   "category",
                                   "count",
                                   "avg_distance_km",
                                   "avg_price_eur",
                                   "avg_duration_days",
                                   "total_capacity",
                                   "total_participants",
                                   "market_share_percent"
                               ]
                           }
                       },
                       "tours_popularity": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "properties": {
                                   "tour_name": {
                                       "type": "string"
                                   },
                                   "category": {
                                       "type": "string",
                                       "enum": [
                                           "easy",
                                           "moderate",
                                           "challenging",
                                           "difficult",
                                           "expert"
                                       ]
                                   },
                                   "total_bookings": {
                                       "type": "integer",
                                       "minimum": 0
                                   },
                                   "capacity": {
                                       "type": "integer",
                                       "minimum": 0
                                   },
                                   "occupancy_rate_percent": {
                                       "type": "number",
                                       "minimum": 0,
                                       "maximum": 100
                                   },
                                   "price_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "distance_km": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "start_date": {
                                       "type": "string",
                                       "format": "date"
                                   }
                               },
                               "required": [
                                   "tour_name",
                                   "category",
                                   "total_bookings",
                                   "capacity",
                                   "occupancy_rate_percent",
                                   "price_eur",
                                   "distance_km",
                                   "start_date"
                               ]
                           }
                       }
                   },
                   "required": [
                       "tours_by_category",
                       "tours_popularity"
                   ]
               },
               "revenue_analytics": {
                   "type": "object",
                   "properties": {
                       "total_revenue_eur": {
                           "type": "number",
                           "minimum": 0
                       },
                       "average_booking_value_eur": {
                           "type": "number",
                           "minimum": 0
                       },
                       "revenue_by_tour": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "properties": {
                                   "tour_name": {
                                       "type": "string"
                                   },
                                   "category": {
                                       "type": "string",
                                       "enum": [
                                           "easy",
                                           "moderate",
                                           "challenging",
                                           "difficult",
                                           "expert"
                                       ]
                                   },
                                   "revenue_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "bookings_count": {
                                       "type": "integer",
                                       "minimum": 0
                                   },
                                   "avg_revenue_per_booking_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   }
                               },
                               "required": [
                                   "tour_name",
                                   "category",
                                   "revenue_eur",
                                   "bookings_count",
                                   "avg_revenue_per_booking_eur"
                               ]
                           }
                       },
                       "revenue_by_category": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "properties": {
                                   "category": {
                                       "type": "string",
                                       "enum": [
                                           "easy",
                                           "moderate",
                                           "challenging",
                                           "difficult",
                                           "expert"
                                       ]
                                   },
                                   "revenue_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "bookings_count": {
                                       "type": "integer",
                                       "minimum": 0
                                   }
                               },
                               "required": [
                                   "category",
                                   "revenue_eur",
                                   "bookings_count"
                               ]
                           }
                       }
                   },
                   "required": [
                       "total_revenue_eur",
                       "average_booking_value_eur",
                       "revenue_by_tour",
                       "revenue_by_category"
                   ]
               },
               "package_roi": {
                   "type": "array",
                   "items": {
                       "type": "object",
                       "properties": {
                           "package_name": {
                               "type": "string"
                           },
                           "code": {
                               "type": "string"
                           },
                           "discount_percent": {
                               "type": "number",
                               "minimum": 0,
                               "maximum": 100
                           },
                           "times_used": {
                               "type": "integer",
                               "minimum": 0
                           },
                           "total_discount_given_eur": {
                               "type": "number",
                               "minimum": 0
                           },
                           "revenue_with_package_eur": {
                               "type": "number",
                               "minimum": 0
                           },
                           "adoption_rate_percent": {
                               "type": "number",
                               "minimum": 0,
                               "maximum": 100
                           }
                       },
                       "required": [
                           "package_name",
                           "code",
                           "discount_percent",
                           "times_used",
                           "total_discount_given_eur",
                           "revenue_with_package_eur",
                           "adoption_rate_percent"
                       ]
                   }
               },
               "pricing_strategy": {
                   "type": "object",
                   "properties": {
                       "price_per_km_analysis": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "properties": {
                                   "tour_name": {
                                       "type": "string"
                                   },
                                   "category": {
                                       "type": "string",
                                       "enum": [
                                           "easy",
                                           "moderate",
                                           "challenging",
                                           "difficult",
                                           "expert"
                                       ]
                                   },
                                   "price_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "distance_km": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "price_per_km_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "occupancy_rate_percent": {
                                       "type": "number",
                                       "minimum": 0,
                                       "maximum": 100
                                   }
                               },
                               "required": [
                                   "tour_name",
                                   "category",
                                   "price_eur",
                                   "distance_km",
                                   "price_per_km_eur",
                                   "occupancy_rate_percent"
                               ]
                           }
                       },
                       "bike_rental_profitability": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "properties": {
                                   "bike_type": {
                                       "type": "string",
                                       "enum": [
                                           "road",
                                           "mountain",
                                           "hybrid",
                                           "touring",
                                           "electric",
                                           "gravel",
                                           "city",
                                           "folding"
                                       ]
                                   },
                                   "avg_rental_price_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   },
                                   "rental_frequency_percent": {
                                       "type": "number",
                                       "minimum": 0,
                                       "maximum": 100
                                   },
                                   "estimated_revenue_eur": {
                                       "type": "number",
                                       "minimum": 0
                                   }
                               },
                               "required": [
                                   "bike_type",
                                   "avg_rental_price_eur",
                                   "rental_frequency_percent",
                                   "estimated_revenue_eur"
                               ]
                           }
                       }
                   },
                   "required": [
                       "price_per_km_analysis",
                       "bike_rental_profitability"
                   ]
               },
               "performance_summary": {
                   "type": "object",
                   "properties": {
                       "total_revenue_eur": {
                           "type": "number",
                           "minimum": 0
                       },
                       "total_bookings": {
                           "type": "integer",
                           "minimum": 0
                       },
                       "avg_revenue_per_booking_eur": {
                           "type": "number",
                           "minimum": 0
                       },
                       "overall_occupancy_rate_percent": {
                           "type": "number",
                           "minimum": 0,
                           "maximum": 100
                       },
                       "best_performing_category": {
                           "type": "string",
                           "enum": [
                               "easy",
                               "moderate",
                               "challenging",
                               "difficult",
                               "expert"
                           ]
                       },
                       "package_adoption_rate_percent": {
                           "type": "number",
                           "minimum": 0,
                           "maximum": 100
                       }
                   },
                   "required": [
                       "total_revenue_eur",
                       "total_bookings",
                       "avg_revenue_per_booking_eur",
                       "overall_occupancy_rate_percent",
                       "best_performing_category",
                       "package_adoption_rate_percent"
                   ]
               }
           },
           "required": [
               "market_analysis",
               "revenue_analytics",
               "package_roi",
               "pricing_strategy",
               "performance_summary"
           ]
       }
   },
   "required": [
       "business_intelligence"
   ]
}

